APP_ENV=staging
MODE=cloud
APP_NAME=Product Page Creator (Staging)
APP_VERSION=2.0.0

# Security
AUTH_ENABLED=true
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_TOKEN_TTL_HOURS=24
ADMIN_EMAIL=dev-bot@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=replace-with-sha256-hash

# API network
FRONTEND_URL=https://staging-app.yourdomain.com
TRUSTED_HOSTS=staging-api.yourdomain.com,staging-app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://staging-app.yourdomain.com
REQUEST_MAX_MB=30

# Data (separate from production)
DATABASE_URL=postgresql://...

# Storage (separate bucket/prefix from production)
STORAGE_BACKEND=s3
STORAGE_BUCKET=ppc-assets-staging
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Worker behavior
WORKER_POLL_SECONDS=3
WORKER_MAX_RETRIES=1

# App behavior
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
DEFAULT_MODELS=openrouter/openrouter/free,gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile
MODEL_FALLBACK_CHAIN=openrouter,gemini,groq,openai,anthropic,mistral,cohere,perplexity,xai
OUTPUT_DIR=/tmp/product-assets
BRAND_EXAMPLES_DIR=brand-examples
PLAYWRIGHT_ENABLED=true
REMBG_ENABLED=true
WEBP_QUALITY=90
