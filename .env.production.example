APP_ENV=production
MODE=cloud
APP_NAME=Product Page Creator
APP_VERSION=2.0.0

# Security
AUTH_ENABLED=true
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_TOKEN_TTL_HOURS=24
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=replace-with-sha256-hash

# API network
FRONTEND_URL=https://your-frontend-domain
TRUSTED_HOSTS=your-backend-domain.onrender.com,your-frontend-domain
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
REQUEST_MAX_MB=30

# Data
DATABASE_URL=postgresql://...

# Storage (Cloudflare R2 / S3-compatible)
STORAGE_BACKEND=s3
STORAGE_BUCKET=your-bucket
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Worker behavior
WORKER_POLL_SECONDS=5
WORKER_MAX_RETRIES=2

# App behavior
OLLAMA_BASE_URL=http://localhost:11434
TEXT_MODEL=qwen2.5:7b-instruct
VISION_MODEL=qwen2.5vl:7b
OUTPUT_DIR=/tmp/product-assets
BRAND_EXAMPLES_DIR=brand-examples
PLAYWRIGHT_ENABLED=true
REMBG_ENABLED=true
WEBP_QUALITY=90
